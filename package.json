  "version": "0.0.0",
  "type": "module",
  "homepage": "http://kagegrifon.github.io/quiz-train",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
